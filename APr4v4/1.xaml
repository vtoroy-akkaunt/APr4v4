<Page x:Class="APr4v4._1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:APr4v4"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="_1">

    <Grid>
        <StackPanel Orientation="Vertical">
            <Image Height="50" Source="/Resources/Image1.png"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label Content="x"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="x"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="y"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="y"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="z"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="z"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Результат"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" IsReadOnly="True" x:Name="res"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Вычислить" x:Name="to_calc" Click="to_calc_Click"/>
                    <Button Content="Очистить" x:Name="to_clear" Click="to_clear_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
