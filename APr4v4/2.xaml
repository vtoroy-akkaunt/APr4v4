<Page x:Class="APr4v4._2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:APr4v4"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="_2">

    <Grid>
        <StackPanel Orientation="Vertical">
            <Image Height="50" Source="/Resources/Image2.png" ToolTip="График"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label Content="x" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="x" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="y" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="y" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="fx" Content="sh(x)" x:Name="fx_shx" IsChecked="True" ToolTip="Опция"></RadioButton>
                    <RadioButton GroupName="fx" Content="x^2" x:Name="fx_x2" ToolTip="Опция"></RadioButton>
                    <RadioButton GroupName="fx" Content="e^x" x:Name="fx_ex" ToolTip="Опция"></RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Результат" ToolTip="Подпись к полю вывода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" IsReadOnly="True" x:Name="res" ToolTip="Поле вывода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Вычислить" x:Name="to_calc" Click="to_calc_Click" ToolTip="Кнопка, по подписи на которой очевидно, что она делает"/>
                    <Button Content="Очистить" x:Name="to_clear" Click="to_clear_Click" ToolTip="Кнопка, по подписи на которой очевидно, что она делает"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
