<Page x:Class="APr4v4._3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:APr4v4"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="_3">

<Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical">
            <Image Height="50" Source="/Resources/Image3.png" ToolTip="Формула"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Label Content="a" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="a_" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="b" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="b_" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="x_0" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="x_0_" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="x_k" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="x_k_" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="dx" ToolTip="Подпись к полю ввода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="dx_" ToolTip="Поле ввода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Результаты" ToolTip="Подпись к полю вывода"></Label>
                    <TextBox TextWrapping="Wrap" Width="120" x:Name="res_" IsReadOnly="True" MaxHeight="150" ToolTip="Поле вывода значения"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Вычислить" x:Name="to_calc" Click="to_calc_Click" ToolTip="Кнопка, по подписи на которой очевидно, что она делает"/>
                    <Button Content="Очистить" x:Name="to_clear" Click="to_clear_Click" ToolTip="Кнопка, по подписи на которой очевидно, что она делает"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
            <WindowsFormsHost Height="300" Width="400" ToolTip="График">
                <charts:Chart x:Name="the_chart">
                    <charts:Chart.Legends>
                        <charts:Legend></charts:Legend>
                    </charts:Chart.Legends>
                </charts:Chart>
            </WindowsFormsHost>
        </StackPanel>
</Grid>
</Page>
